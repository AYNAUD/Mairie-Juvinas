{
  "name": "mairie-juvinas",
  "version": "0.1.0",
  "description": "Site officiel de la commune de Juvinas (07600) - generateur statique, une seule dependance (unpdf, extraction du texte des PV pour la recherche)",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node src/build.mjs",
    "dev": "node src/build.mjs && node tools/serve.mjs",
    "check": "node src/build.mjs && node tools/check.mjs && node tools/test-recherche.mjs",
    "entreprises": "node tools/fetch-entreprises.mjs",
    "defibrillateurs": "node tools/fetch-defibrillateurs.mjs",
    "finances": "node tools/fetch-finances.mjs",
    "carte": "node tools/fetch-carte-fond.mjs",
    "carte:tourisme": "node tools/fetch-carte-tourisme.mjs",
    "zonage": "node tools/fetch-zonage.mjs",
    "pv:importer": "node tools/importer-pv.mjs",
    "test": "node tools/test-recherche.mjs",
    "worker:test": "node worker/test-local.mjs",
    "worker:deploy": "npx wrangler deploy --config worker/wrangler.toml"
  },
  "dependencies": {
    "unpdf": "^1.8.1"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "UNLICENSED"
}
